#!/usr/bin/env python3
"""roke: a rofi front-end for KeePass databases. See specs.md.

Run as fuzke, or with --cli, for the terminal version, which uses fzf.
Escape always goes back one menu; at the database list it exits.
"""

import argparse
import base64
import getpass
import hashlib
import hmac
import html
import json
import os
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from pathlib import Path

from cryptography.exceptions import InvalidTag
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

# KeePassXC's default Auto-Type delays, in milliseconds (specs.md §2.5.1).
AUTOTYPE_START_DELAY_MS = 500
AUTOTYPE_KEY_DELAY_MS = 25

RECENT_DATABASES = "recent-databases"
RECENT_DIRECTORIES = "recent-directories"
RECENT_LIMIT = 30
EXCLUDED_GROUPS = "excluded-groups"
SALT = "salt"
CONFIG = "config"

CHOOSE = "Choose…"
NAVIGATE = "Navigate groups"
ACTIONS = ("Autotype", "Copy password", "View notes")
AUTOTYPE_DELAYS = (1, 2, 3, 5, 10, 15, 30)  # seconds, offered by fuzke

# XDG user directories offered as starting places, with their usual names.
XDG_PLACES = {
    "DESKTOP": "Desktop",
    "DOCUMENTS": "Documents",
    "DOWNLOAD": "Downloads",
    "MUSIC": "Music",
    "PICTURES": "Pictures",
    "VIDEOS": "Videos",
}


class Failure(Exception):
    """An error to show the user before exiting."""


class Quit(Exception):
    """The user chose to abort."""


# --- persisted plain-text state (specs.md §3.2) ---------------------------


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / "roke"


def write_atomic(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def read_recent(name: str) -> list[str]:
    try:
        text = (config_dir() / name).read_text()
    except FileNotFoundError:
        return []
    return [line for line in text.splitlines() if line]


def push_recent(name: str, item: str) -> None:
    items = [item] + [i for i in read_recent(name) if i != item]
    write_atomic(config_dir() / name, ("\n".join(items[:RECENT_LIMIT]) + "\n").encode())


def read_config() -> dict[str, str]:
    """The key=value settings in ~/.config/roke/config."""
    settings = {}
    for line in read_recent(CONFIG):
        key, sep, value = line.partition("=")
        if sep:
            settings[key.strip()] = value.strip()
    return settings


def write_config(settings: dict[str, str]) -> None:
    write_atomic(config_dir() / CONFIG, "".join(f"{k}={v}\n" for k, v in settings.items()).encode())


# --- user interfaces (specs.md §2, §4) --------------------------------------

# A menu row is a string or a list of (text, style) spans. The styles colour
# the terminal version (TerminalUI.STYLES); rofi shows the plain text.


def plain(row) -> str:
    return row if isinstance(row, str) else "".join(text for text, _ in row)


class RofiUI:
    """Menus and prompts in rofi, fed over stdin: nothing is passed on the
    command line or written to disk."""

    command = "rofi"

    @staticmethod
    def clean(text: str) -> str:
        """Make text safe to use as a single rofi row."""
        return text.replace("\n", " ").replace("\0", "").replace("\x1f", "")

    def choose(self, prompt, rows, *, mesg=None, meta=None, sort=False):
        """Return the selected row's index, or None on Escape. With sort,
        matches are ranked by fzf score against the row text only (never
        meta), ties keeping row order; an empty query keeps row order."""
        cmd = ["rofi", "-dmenu", "-i", "-p", prompt, "-format", "i", "-no-custom", "-matching", "fuzzy"]
        if mesg:
            cmd += ["-mesg", html.escape(mesg)]
        if sort:
            cmd += ["-sort", "-sorting-method", "fzf"]
        lines = []
        for i, row in enumerate(rows):
            line = self.clean(plain(row))
            if meta:
                line += "\0meta\x1f" + self.clean(meta[i])
            lines.append(line)
        proc = subprocess.run(cmd, input="\n".join(lines), capture_output=True, text=True)
        return None if proc.returncode else int(proc.stdout)

    def password(self, prompt, mesg=None):
        """Return the typed password, or None on Escape."""
        cmd = ["rofi", "-dmenu", "-p", prompt, "-password", "-theme-str", "listview { enabled: false; }"]
        if mesg:
            cmd += ["-mesg", html.escape(mesg)]
        proc = subprocess.run(cmd, input="", capture_output=True, text=True)
        return None if proc.returncode else proc.stdout.rstrip("\n")

    def autotype_delay(self):
        return AUTOTYPE_START_DELAY_MS / 1000

    def countdown(self, seconds: float) -> None:
        time.sleep(seconds)

    def notice(self, message: str) -> None:
        pass

    def error(self, message: str) -> None:
        subprocess.run(["rofi", "-e", message])


class TerminalUI:
    """The terminal version, fuzke: fzf menus, colours, a password prompt
    without echo, and an autotype delay chosen per use (specs.md §4)."""

    command = "fzf"
    STYLES = {
        "title": "1",           # bold
        "group": "36",          # cyan
        "dim": "2",
        "database": "1;32",     # bold green
        "directory": "34",      # blue
        "special": "1;35",      # bold magenta: Choose…, Navigate groups
        "toggle": "33",         # yellow
        "danger": "31",         # red
        "ok": "32",             # green
    }
    FZF_COLORS = (
        "prompt:magenta,pointer:magenta,marker:magenta,spinner:magenta,"
        "hl:yellow,hl+:yellow,header:cyan,info:blue,border:blue,label:magenta"
    )

    def __init__(self):
        self.color = "NO_COLOR" not in os.environ

    @staticmethod
    def clean(text: str) -> str:
        """Drop control characters, so entry text cannot inject terminal
        escapes or break a row."""
        return "".join(" " if c in "\t\n" else c for c in text if c in "\t\n" or c.isprintable())

    def paint(self, text: str, style=None) -> str:
        return f"\033[{self.STYLES[style]}m{text}\033[0m" if self.color and style else text

    def say(self, text: str, style=None) -> None:
        print(self.paint(text, style), file=sys.stderr)

    def choose(self, prompt, rows, *, mesg=None, meta=None, sort=False):
        """Return the selected row's index, or None on Escape. Rows are fed
        over stdin as "index<TAB>row<TAB>meta"; the index is hidden and meta,
        which fzf can only search when shown, is dimmed. With sort, ties
        prefer matches nearer the start of the row, then row order."""
        lines = []
        for i, row in enumerate(rows):
            spans = [(row, None)] if isinstance(row, str) else row
            shown = "".join(self.paint(self.clean(text), style) for text, style in spans)
            hidden = self.paint(self.clean(meta[i]), "dim") if meta and meta[i] else ""
            lines.append(f"{i}\t{shown}\t{hidden}")
        cmd = [
            "fzf", "--ansi", "--delimiter", "\t", "--with-nth", "2..",
            "--layout", "reverse", "--border", "rounded", "--border-label", " fuzke ",
            "--info", "inline", "--prompt", f"{prompt} › ",
            "--color", self.FZF_COLORS if self.color else "bw",
        ]
        if mesg:
            cmd += ["--header", self.clean(mesg)]
        cmd += ["--tiebreak", "begin,index"] if sort else ["--no-sort"]
        proc = subprocess.run(cmd, input="\n".join(lines), stdout=subprocess.PIPE, text=True)
        return None if proc.returncode else int(proc.stdout.split("\t", 1)[0])

    def password(self, prompt, mesg=None):
        """Read the password from the terminal without echo; Ctrl-C or
        Ctrl-D returns None."""
        if mesg:
            self.say(self.clean(mesg), "group")
        try:
            return getpass.getpass(self.paint(f"{prompt}: ", "special"))
        except (KeyboardInterrupt, EOFError):
            print(file=sys.stderr)
            return None

    def autotype_delay(self):
        """Ask how many seconds to wait before typing; None on Escape."""
        rows = [[(f"{n} second" + "s" * (n != 1), "title")] for n in AUTOTYPE_DELAYS]
        i = self.choose("Autotype in", rows, mesg="Time to switch to the target window")
        return None if i is None else AUTOTYPE_DELAYS[i]

    def countdown(self, seconds: float) -> None:
        """Count down on the terminal; Ctrl-C raises KeyboardInterrupt."""
        try:
            for left in range(int(seconds), 0, -1):
                print(
                    "\r" + self.paint(f"Typing in {left}…", "special")
                    + self.paint(" switch to the target window (Ctrl-C cancels) ", "dim"),
                    end="", file=sys.stderr, flush=True,
                )
                time.sleep(1)
        finally:
            print("\r\033[K", end="", file=sys.stderr, flush=True)

    def notice(self, message: str) -> None:
        self.say(message, "ok")

    def error(self, message: str) -> None:
        self.say(f"roke: {message}", "danger")


ui = RofiUI()


def require(command: str) -> None:
    if not shutil.which(command):
        raise Failure(f"{command} is not installed.")


def tilde(path) -> str:
    path, home = str(path), str(Path.home())
    if path == home or path.startswith(home + "/"):
        return "~" + path[len(home):]
    return path


# --- database selection and directory browser (specs.md §2.1, §2.2) -------


def unique_dirs(paths) -> list[Path]:
    return [p for p in dict.fromkeys(Path(p) for p in paths) if p.is_dir()]


def common_places() -> list[Path]:
    """Home, the XDG user directories and /, as a file manager's places."""
    home = Path.home()
    places = {key: home / name for key, name in XDG_PLACES.items()}
    base = os.environ.get("XDG_CONFIG_HOME") or home / ".config"
    try:
        text = (Path(base) / "user-dirs.dirs").read_text()
    except OSError:
        text = ""
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        key = key.strip().removeprefix("XDG_").removesuffix("_DIR")
        if sep and key in places:
            places[key] = Path(value.strip().strip('"').replace("$HOME", str(home)))
    return unique_dirs([home, *places.values(), "/"])


def list_directory(directory: Path) -> tuple[list[Path], list[Path]]:
    """Return the KeePass databases and the subdirectories of directory,
    skipping hidden ones."""
    databases, subdirs = [], []
    try:
        children = sorted(directory.iterdir(), key=lambda p: p.name.casefold())
    except OSError:
        return [], []
    for child in children:
        if child.name.startswith("."):
            continue
        try:
            if child.is_dir():
                subdirs.append(child)
            elif child.suffix.lower() == ".kdbx" and child.is_file():
                databases.append(child)
        except OSError:
            continue
    return databases, subdirs


def browse_directory(directory: Path):
    """List a directory's databases, then '..', then its subdirectories."""
    while True:
        databases, subdirs = list_directory(directory)
        targets = [([(p.name, "database")], p) for p in databases]
        if directory.parent != directory:
            targets.append(([("../", "dim")], directory.parent))
        targets += [([(p.name + "/", "directory")], p) for p in subdirs]
        i = ui.choose("Browse", [row for row, _ in targets], mesg=tilde(directory))
        if i is None:
            return None
        target = targets[i][1]
        if target in databases:
            return target
        directory = target


def browse():
    """The directory browser; returns the chosen database or None."""
    while True:
        places = unique_dirs([*common_places(), *read_recent(RECENT_DIRECTORIES)])
        i = ui.choose("Choose", [[(tilde(p), "directory")] for p in places])
        if i is None:
            return None
        database = browse_directory(places[i])
        if database:
            push_recent(RECENT_DIRECTORIES, str(database.parent))
            return database


def choose_database():
    """Recent databases, newest first, then Choose…; returns a path or None."""
    while True:
        recent = [Path(p) for p in read_recent(RECENT_DATABASES) if Path(p).is_file()]
        i = ui.choose("Database", [*([(tilde(p), "database")] for p in recent), [(CHOOSE, "special")]])
        if i is None:
            return None
        if i < len(recent):
            return recent[i]
        database = browse()
        if database:
            return database


# --- unlocking (specs.md §2.3) ----------------------------------------------


@dataclass
class Entry:
    uuid: str
    groups: tuple[str, ...]  # group names from below the root group down
    title: str
    username: str
    url: str
    password: str
    notes: str

    @property
    def group(self) -> str:
        """"Group > Subgroup"."""
        return " > ".join(self.groups)

    @property
    def path(self) -> str:
        """"Group > Subgroup > Title"."""
        return " > ".join(filter(None, [self.group, self.title or "(untitled)"]))

    @property
    def row(self) -> list[tuple[str, str]]:
        """The entry list row. The title comes first because rofi's sort
        favours matches near the start of the row (specs.md §2.4)."""
        row = [(self.title or "(untitled)", "title")]
        if self.group:
            row += [("  ·  ", "dim"), (self.group, "group")]
        return row

    @property
    def label(self) -> str:
        return plain(self.row)


@dataclass
class Group:
    names: tuple[str, ...]  # group names from below the root; () is the root
    groups: list["Group"] = field(default_factory=list)
    entries: list[Entry] = field(default_factory=list)

    def walk(self):
        """Every entry in this group and its subgroups."""
        yield from self.entries
        for sub in self.groups:
            yield from sub.walk()


def parse_export(xml: bytes) -> Group:
    """Read the group tree of a KeePass XML export, skipping entry history
    and the recycle bin."""
    root = ET.fromstring(xml)
    recycle_bin = root.findtext("Meta/RecycleBinUUID")

    def read_group(element, names):
        group = Group(names)
        for entry in element.findall("Entry"):
            fields = {s.findtext("Key"): s.findtext("Value") or "" for s in entry.findall("String")}
            group.entries.append(Entry(
                uuid=entry.findtext("UUID"),
                groups=names,
                title=fields.get("Title", ""),
                username=fields.get("UserName", ""),
                url=fields.get("URL", ""),
                password=fields.get("Password", ""),
                notes=fields.get("Notes", ""),
            ))
        for sub in element.findall("Group"):
            if sub.findtext("UUID") != recycle_bin:
                group.groups.append(read_group(sub, (*names, sub.findtext("Name") or "")))
        return group

    top = root.find("Root/Group")
    return read_group(top, ()) if top is not None else Group(())


def open_database(database: Path, password: str):
    """Decrypt the database into memory with keepassxc-cli. Returns
    (root group, None) on success or (None, error message) on failure."""
    proc = subprocess.run(
        ["keepassxc-cli", "export", "--format", "xml", str(database)],
        input=(password + "\n").encode(),
        capture_output=True,
    )
    if proc.returncode != 0:
        lines = [
            line for line in proc.stderr.decode(errors="replace").splitlines()
            if line.strip() and not line.startswith("Enter password")
        ]
        return None, lines[0] if lines else "Could not open the database."
    return parse_export(proc.stdout), None


def unlock(database: Path):
    """Prompt for the master password until it works. Returns (root group,
    password), None to go back, or raises Quit if the user aborts."""
    while True:
        password = ui.password("Password", mesg=tilde(database))
        if password is None:
            return None
        root, error = open_database(database, password)
        if root is not None:
            push_recent(RECENT_DATABASES, str(database))
            return root, password
        if ui.choose("Unlock failed", [[("Try again", "title")], [("Abort", "danger")]], mesg=error) != 0:
            raise Quit


# --- encrypted entry last-use times (specs.md §3.2) -------------------------


def derive_key(password: str, salt: bytes) -> bytes:
    return hashlib.scrypt(
        password.encode(), salt=salt, n=2**15, r=8, p=1, maxmem=64 * 2**20, dklen=32
    )


class UsageLog:
    """When each entry was last used, kept in a per-database file encrypted
    with the database's master password."""

    AAD = b"roke-usage-v1"

    def __init__(self, database: Path, password: str):
        name = hashlib.sha256(str(database.absolute()).encode()).hexdigest()
        self.file = config_dir() / "cache" / name
        try:
            self.times = self._load(password)
        except FileNotFoundError:
            self._start(password)
        except (InvalidTag, ValueError, KeyError, TypeError):
            # The file does not decrypt with the password that just unlocked
            # the database, so the master password changed: start over.
            self.file.unlink(missing_ok=True)
            self._start(password)

    def _load(self, password: str) -> dict:
        blob = json.loads(self.file.read_bytes())
        self.salt = base64.b64decode(blob["salt"])
        self.key = derive_key(password, self.salt)
        plain = AESGCM(self.key).decrypt(
            base64.b64decode(blob["nonce"]), base64.b64decode(blob["data"]), self.AAD
        )
        return json.loads(plain)

    def _start(self, password: str) -> None:
        self.salt = os.urandom(16)
        self.key = derive_key(password, self.salt)
        self.times = {}

    def last_used(self, entry: Entry) -> float:
        return self.times.get(entry.uuid, 0)

    def touch(self, entry: Entry) -> None:
        self.times[entry.uuid] = time.time()
        nonce = os.urandom(12)
        data = AESGCM(self.key).encrypt(nonce, json.dumps(self.times).encode(), self.AAD)
        write_atomic(self.file, json.dumps({
            "version": 1,
            "salt": base64.b64encode(self.salt).decode(),
            "nonce": base64.b64encode(nonce).decode(),
            "data": base64.b64encode(data).decode(),
        }).encode())


# --- excluded groups (specs.md §2.6, §3.2) ----------------------------------


class Exclusions:
    """Groups hidden from the entry list. Only salted hashes of (database
    path, group path) are stored, so the file survives master password
    changes without naming any group."""

    def __init__(self, database: Path):
        self.database = str(database.absolute())
        salt_file = config_dir() / SALT
        try:
            self.salt = bytes.fromhex(salt_file.read_text().strip())
        except (FileNotFoundError, ValueError):
            self.salt = os.urandom(32)
            write_atomic(salt_file, (self.salt.hex() + "\n").encode())
        self.hashes = set(read_recent(EXCLUDED_GROUPS))

    def _hash(self, names: tuple[str, ...]) -> str:
        message = json.dumps([self.database, *names]).encode()
        return hmac.new(self.salt, message, hashlib.sha256).hexdigest()

    def excludes(self, names: tuple[str, ...]) -> bool:
        """Whether this group itself is excluded."""
        return bool(names) and self._hash(names) in self.hashes

    def hides(self, names: tuple[str, ...]) -> bool:
        """Whether this group or one of its ancestors is excluded."""
        return any(self.excludes(names[:i]) for i in range(1, len(names) + 1))

    def toggle(self, names: tuple[str, ...]) -> None:
        self.hashes ^= {self._hash(names)}
        write_atomic(config_dir() / EXCLUDED_GROUPS, "".join(h + "\n" for h in sorted(self.hashes)).encode())


# --- entries and actions (specs.md §2.4, §2.5) ------------------------------


def pick_entry(database: Path, root: Group, usage: UsageLog, exclusions: Exclusions):
    """The entry list: used entries by last use, then Navigate groups, then
    the never-used entries by name, all without excluded groups. Filtering
    also matches username and URL, which rank below the visible text.
    Returns an Entry, NAVIGATE, or None."""
    entries = [e for e in root.walk() if not exclusions.hides(e.groups)]
    used = sorted((e for e in entries if usage.last_used(e)), key=usage.last_used, reverse=True)
    unused = sorted((e for e in entries if not usage.last_used(e)), key=lambda e: e.label.casefold())
    rows = [*used, NAVIGATE, *unused]
    i = ui.choose(
        database.stem,
        [[(NAVIGATE, "special")] if row is NAVIGATE else row.row for row in rows],
        meta=["" if row is NAVIGATE else f"{row.username} {row.url}" for row in rows],
        sort=True,
    )
    return None if i is None else rows[i]


def navigate(group: Group, usage: UsageLog, exclusions: Exclusions) -> bool:
    """Browse a group: '..', the exclude/include toggle (not for the root),
    its subgroups, then its entries. Returns True once a password was used."""
    while True:
        rows = [([("..", "dim")], None)]
        if group.names:
            toggle = "Include group" if exclusions.excludes(group.names) else "Exclude group"
            rows.append(([(toggle, "toggle")], "toggle"))
        rows += [([(sub.names[-1] + " >", "directory")], sub) for sub in group.groups]
        rows += [([(entry.title or "(untitled)", "title")], entry) for entry in group.entries]
        mesg = " > ".join(group.names) or "Root"
        if exclusions.hides(group.names):
            mesg += " (excluded from the entry list)"
        i = ui.choose(
            "Groups",
            [row for row, _ in rows],
            mesg=mesg,
            meta=[f"{t.username} {t.url}" if isinstance(t, Entry) else "" for _, t in rows],
        )
        target = None if i is None else rows[i][1]
        if target is None:
            return False
        if target == "toggle":
            exclusions.toggle(group.names)
        elif isinstance(target, Group):
            if navigate(target, usage, exclusions):
                return True
        elif run_actions(target, usage):
            return True


def autotype(text: str, delay: float) -> bool:
    """Type text after delay seconds; returns False if cancelled."""
    if shutil.which("dotool"):
        cmd = ["dotool"]
        script = f"typedelay {AUTOTYPE_KEY_DELAY_MS}\ntype {text}\n"
    elif shutil.which("xdotool"):
        cmd = ["xdotool", "type", "--delay", str(AUTOTYPE_KEY_DELAY_MS), "--file", "-"]
        script = text
    else:
        raise Failure("dotool is not installed.")
    # Start the typist before the delay so dotool's virtual keyboard is ready
    # by the time it ends. The text goes over stdin, never on a command line.
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, text=True)
    try:
        ui.countdown(delay)
    except KeyboardInterrupt:
        proc.kill()
        proc.wait()
        return False
    proc.communicate(script)
    if proc.returncode != 0:
        raise Failure(f"{cmd[0]} failed to type the password.")
    return True


def copy_to_clipboard(text: str) -> None:
    require("xclip")
    subprocess.run(
        ["xclip", "-selection", "clipboard"],
        input=text, text=True, stdout=subprocess.DEVNULL, check=True,
    )


def view_notes(entry: Entry) -> None:
    """Show the notes through the menu's stdin, so no file is ever created."""
    ui.choose("Notes", entry.notes.splitlines() or [[("(no notes)", "dim")]], mesg=entry.path)


def run_actions(entry: Entry, usage: UsageLog) -> bool:
    """The entry's action menu; returns True once the password was used."""
    while True:
        i = ui.choose("Action", [[(a, "title")] for a in ACTIONS], mesg=entry.path)
        if i is None:
            return False
        if i == 0:
            delay = ui.autotype_delay()
            if delay is None or not autotype(entry.password, delay):
                continue
            ui.notice("Password typed.")
        elif i == 1:
            copy_to_clipboard(entry.password)
            ui.notice("Password copied to the clipboard.")
        else:
            view_notes(entry)
        usage.touch(entry)
        if i in (0, 1):
            return True


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="roke",
        description="Open a KeePass database and autotype, copy or read an entry. "
        "fuzke is the terminal version.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--cli", action="store_true", help="use the terminal version (fzf)")
    mode.add_argument("--rofi", action="store_true", help="use the rofi version")
    mode.add_argument(
        "--default", choices=("cli", "rofi"),
        help="save which version roke uses when started from a terminal, then exit",
    )
    parser.add_argument(
        "database", nargs="?",
        help="a .kdbx file to open straight away; it is added to the recent databases",
    )
    return parser.parse_args(argv)


def pick_ui(args, program: str):
    """fuzke and --cli mean the terminal version, --rofi means rofi. Otherwise
    roke uses the saved default (§4.1), but only from a terminal."""
    if program == "fuzke" or args.cli:
        return TerminalUI()
    if args.rofi:
        return RofiUI()
    if read_config().get("default") == "cli" and sys.stdin.isatty():
        return TerminalUI()
    return RofiUI()


def main(argv=None) -> int:
    global ui
    os.umask(0o077)
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.default:
        write_config({**read_config(), "default": args.default})
        if args.default == "cli":
            print("roke now uses the terminal version when started from a terminal.")
        else:
            print("roke now always uses rofi.")
        return 0
    ui = pick_ui(args, Path(sys.argv[0]).name)
    try:
        require(ui.command)
        require("keepassxc-cli")
        requested = None
        if args.database:
            # Opened from the command line: recent right away (§2.1).
            requested = Path(os.path.abspath(args.database))
            if not requested.is_file():
                raise Failure(f"{requested} does not exist.")
            push_recent(RECENT_DATABASES, str(requested))
        while (database := requested or choose_database()) is not None:
            requested = None  # going back from here leads to the database list
            unlocked = unlock(database)
            if unlocked is None:
                continue
            root, password = unlocked
            usage = UsageLog(database, password)
            exclusions = Exclusions(database)
            while (choice := pick_entry(database, root, usage, exclusions)) is not None:
                if choice is NAVIGATE:
                    done = navigate(root, usage, exclusions)
                else:
                    done = run_actions(choice, usage)
                if done:
                    return 0
        return 0
    except Quit:
        return 1
    except KeyboardInterrupt:
        return 130
    except Failure as e:
        if shutil.which(ui.command):
            ui.error(str(e))
        else:
            print(f"roke: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
